<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
        elementFormDefault="qualified"
        targetNamespace="http://smartservice.qld.gov.au/payment/schemas/payment_query_1_0">

    <xsd:element name="PaymentQueryRequest">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="paymentRequestId" type="xsd:string" nillable="false" minOccurs="1" maxOccurs="1"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="PaymentQueryResponse">
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="status" type="xsd:string" nillable="false" minOccurs="1" maxOccurs="1"/>
                <xsd:element name="receiptNumber" type="xsd:string" nillable="true" minOccurs="0" maxOccurs="1"/>
                <xsd:element name="referenceNumber" type="xsd:string" nillable="true" minOccurs="0" maxOccurs="1"/>
            </xsd:all>
        </xsd:complexType>
    </xsd:element>

</xsd:schema>
